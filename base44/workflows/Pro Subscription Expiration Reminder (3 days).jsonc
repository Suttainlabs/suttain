{
  "name": "Pro Subscription Expiration Reminder (3 days)",
  "description": "Runs daily at 9am CT. Emails Pro users whose subscription expires within 3 days with a renewal prompt. Includes deduplication to prevent duplicate emails.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 14 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pro_subscription_expiration_reminder_3_days",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendProExpirationEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}