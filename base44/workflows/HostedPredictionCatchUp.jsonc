{
  "name": "Hosted prediction catch-up",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hosted_prediction_catch_up",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_jobs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollHostedPredictions",
            "args": {
              "catch_up": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync hosted prediction jobs",
            "description": "Recover missed completion notifications"
          }
        }
      }
    ]
  },
  "description": "Synchronize unfinished Rowan, Boltz and Tamarind binding/ADME jobs submitted through the compute router.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}