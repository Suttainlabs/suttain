{
  "name": "Daily Regulatory Ingredient Alert Check",
  "description": "Runs daily to check if any ingredients in saved formulas have updated regulatory or toxicological status. Creates in-app notifications and sends email alerts to affected users.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_regulatory_ingredient_alert_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkRegulatoryAlerts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}