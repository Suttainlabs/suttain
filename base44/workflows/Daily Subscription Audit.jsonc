{
  "name": "Daily Subscription Audit",
  "description": "Daily sync: fetches all active Stripe subscriptions and ensures only paid users have Pro status. Downgrades users to Free if their subscription has expired or been cancelled in Stripe. Runs without admin auth (scheduler-safe).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_subscription_audit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSubscriptionStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}