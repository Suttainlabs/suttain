{
  "name": "ViewerSettings",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "preferred_engine": {
      "type": "string",
      "enum": [
        "3dmol",
        "ngl"
      ],
      "default": "3dmol",
      "description": "User's preferred molecular visualization engine, applied across all structure viewers"
    }
  },
  "required": [],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}