{
  "name": "ExperimentModule",
  "type": "object",
  "properties": {
    "classroom_id": {
      "type": "string",
      "description": "Reference to the Classroom entity"
    },
    "classroom_name": {
      "type": "string",
      "description": "Denormalized classroom name for display"
    },
    "title": {
      "type": "string",
      "description": "Module title"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Module description and instructions for students"
    },
    "learning_objectives": {
      "type": "string",
      "description": "What students should learn from this module"
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of Suttain tools enabled for this module"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the module assignment is due"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_auto_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this module was auto-created with the classroom"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Current status of the module"
    }
  },
  "required": [
    "classroom_id",
    "title",
    "tool_ids"
  ],
  "rls": {
    "create": null,
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}