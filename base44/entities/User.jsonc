{
  "name": "User",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "User's preferred display name"
    },
    "profile_image_url": {
      "type": "string",
      "description": "URL to user's profile image"
    },
    "reward_points": {
      "type": "number",
      "default": 0,
      "description": "Total reward points earned by the user"
    },
    "first_login": {
      "type": "boolean",
      "default": true,
      "description": "Flag to track if this is user's first login"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "trial",
        "pro",
        "enterprise"
      ],
      "default": "trial",
      "description": "Current subscription plan"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the 14-day trial started (set on first login)"
    },
    "learning_progress": {
      "type": "object",
      "properties": {
        "tutorials": {
          "type": "object",
          "additionalProperties": true,
          "description": "Completed tutorial lessons keyed by tutorial-lesson ID"
        },
        "walkthroughs": {
          "type": "object",
          "additionalProperties": true,
          "description": "Completed walkthrough steps keyed by walkthrough ID"
        }
      },
      "description": "User's learning center progress"
    },
    "compliance_preferences": {
      "type": "object",
      "properties": {
        "default_regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Default target market regions for compliance checks"
        },
        "notification_settings": {
          "type": "object",
          "properties": {
            "email_alerts": {
              "type": "boolean",
              "default": true
            },
            "banned_ingredient_alerts": {
              "type": "boolean",
              "default": true
            },
            "regulatory_updates": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "preferred_standards": {
          "type": "string",
          "enum": [
            "US",
            "EU",
            "Global"
          ],
          "default": "Global",
          "description": "Preferred regional compliance standard"
        }
      }
    },
    "saved_compliance_filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "description": "User's saved compliance filter presets"
    },
    "news_preferences": {
      "type": "object",
      "properties": {
        "saved_articles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of saved news articles"
        },
        "notifications": {
          "type": "object",
          "additionalProperties": true,
          "description": "Notification preferences for news categories"
        }
      },
      "description": "User's regulatory news feed preferences"
    }
  },
  "required": [
    "display_name",
    "profile_image_url",
    "learning_progress",
    "compliance_preferences",
    "saved_compliance_filters",
    "news_preferences"
  ]
}