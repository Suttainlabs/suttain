{
  "name": "User",
  "properties": {
    "admin_granted_access": {
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "boolean"
    },
    "display_name": {
      "type": "string"
    },
    "experience_level": {
      "enum": [
        "beginner",
        "intermediate",
        "expert"
      ],
      "type": "string"
    },
    "first_login": {
      "default": true,
      "type": "boolean"
    },
    "formulation_goals": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generator_category": {
      "enum": [
        "individual",
        "business"
      ],
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "language": {
      "default": "en",
      "description": "User's preferred UI language code",
      "enum": [
        "en",
        "hi",
        "sw",
        "es"
      ],
      "type": "string"
    },
    "last_active_date": {
      "format": "date-time",
      "type": "string"
    },
    "onboarding_goals": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "product_access": {
      "default": [],
      "description": "Product lines the user has paid access to",
      "items": {
        "enum": [
          "core",
          "research",
          "api",
          "farm"
        ],
        "type": "string"
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "array"
    },
    "profile_image_url": {
      "type": "string"
    },
    "referral_code": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "referred_by": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "research_usage_period_start": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "role": {
      "enum": [
        "admin",
        "user"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "simulator_category": {
      "type": "string"
    },
    "stripe_customer_id": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "stripe_subscription_id": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "subscription_billing": {
      "enum": [
        "monthly",
        "yearly",
        "lifetime"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "subscription_end_date": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "subscription_plan": {
      "default": "trial",
      "enum": [
        "free",
        "trial",
        "pro",
        "enterprise",
        "starter",
        "academic",
        "lifetime"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "subscription_status": {
      "default": "trialing",
      "enum": [
        "none",
        "active",
        "canceled",
        "canceling",
        "past_due",
        "trialing",
        "unpaid",
        "incomplete",
        "incomplete_expired"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "target_markets": {
      "description": "Markets the user sells in (e.g. usa, eu, africa)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "trial_start_date": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "usage_formulas": {
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },
    "usage_period_start": {
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "usage_research_simulations": {
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },
    "usage_scans": {
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },
    "usage_simulations": {
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    }
  },
  "required": [],
  "type": "object"
}