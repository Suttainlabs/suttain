{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string"
    },
    "reward_points": {
      "type": "number",
      "default": 0
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "trial",
        "pro",
        "enterprise"
      ],
      "default": "trial"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "trialing"
      ],
      "default": "trialing"
    },
    "subscription_billing": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ]
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the current subscription period ends (from Stripe)"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "first_login": {
      "type": "boolean",
      "default": true
    },
    "onboarding_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User's selected onboarding goals"
    },
    "generator_category": {
      "type": "string",
      "enum": [
        "individual",
        "business"
      ],
      "description": "User's formula generator preference"
    },
    "simulator_category": {
      "type": "string",
      "description": "User's simulator category (role)"
    },
    "industry": {
      "type": "string",
      "description": "User's industry"
    }
  },
  "required": []
}