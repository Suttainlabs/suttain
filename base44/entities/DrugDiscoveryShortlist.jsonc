{
  "name": "DrugDiscoveryShortlist",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "drug": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "sim": {
      "type": "number"
    },
    "synth": {
      "type": "number"
    },
    "source_job_id": {
      "type": "string"
    },
    "added_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "is_illustrative": {
      "type": "boolean",
      "default": true
    },
    "smiles": {
      "type": "string"
    },
    "molecular_weight": {
      "type": "number"
    },
    "logp": {
      "type": "number"
    },
    "tpsa": {
      "type": "number"
    },
    "hbd": {
      "type": "number"
    },
    "hba": {
      "type": "number"
    },
    "rotatable_bonds": {
      "type": "number"
    },
    "lipinski_violations": {
      "type": "number"
    },
    "veber_violations": {
      "type": "number"
    },
    "most_similar_known_ligand": {
      "type": "string"
    },
    "reference_smiles": {
      "type": "string"
    },
    "binding_proxy_score": {
      "type": "number"
    },
    "target_chembl_id": {
      "type": "string"
    },
    "descriptor_method": {
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "drug",
    "score",
    "risk",
    "sim",
    "added_timestamp"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}