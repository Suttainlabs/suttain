{
  "name": "MaterialsSetting",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "materials_project_api_key": {
      "type": "string",
      "description": "User's Materials Project API key from materialsproject.org for live crystal structure and property queries"
    }
  },
  "required": [
    "materials_project_api_key"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}