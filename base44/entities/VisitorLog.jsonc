{
  "name": "VisitorLog",
  "type": "object",
  "properties": {
    "country": {
      "type": "string",
      "description": "Country name of the visitor"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 2-letter country code"
    },
    "region": {
      "type": "string",
      "description": "Region / state of the visitor"
    },
    "city": {
      "type": "string",
      "description": "City of the visitor"
    },
    "page": {
      "type": "string",
      "description": "Page path visited"
    },
    "session_id": {
      "type": "string",
      "description": "Random session ID to deduplicate per-session"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat timestamp \u2014 updated every 30s while visitor is active"
    },
    "current_page": {
      "type": "string",
      "description": "The page the visitor is currently viewing"
    }
  },
  "required": [
    "country"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}