{
  "name": "Diagnosis",
  "type": "object",
  "properties": {
    "farm_id": {
      "type": "string",
      "description": "Reference to Farm entity"
    },
    "farmer_id": {
      "type": "string",
      "description": "Reference to Farmer entity"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo URL of the crop, leaf, or pest"
    },
    "diagnosis": {
      "type": "string",
      "description": "AI-identified diagnosis (disease, pest, or nutrient deficiency)"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Confidence level of the diagnosis"
    },
    "recommended_action": {
      "type": "string",
      "description": "Recommended next step"
    },
    "crop": {
      "type": "string",
      "description": "Crop identified in the photo"
    }
  },
  "required": [
    "farm_id",
    "photo_url",
    "diagnosis"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}