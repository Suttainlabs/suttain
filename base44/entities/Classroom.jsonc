{
  "name": "Classroom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Class or course name (e.g. 'CHEM 201 - Fall 2026')"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Short description of the course and its research scope"
    },
    "class_code": {
      "type": "string",
      "description": "Unique 6-character code students use to join"
    },
    "teacher_name": {
      "type": "string",
      "description": "Denormalized teacher name for display"
    },
    "subject": {
      "type": "string",
      "enum": [
        "chemistry",
        "biology",
        "biochemistry",
        "materials_science",
        "environmental_science",
        "chemical_engineering",
        "pharmacology",
        "other"
      ],
      "default": "chemistry",
      "description": "Primary subject area"
    },
    "grade_level": {
      "type": "string",
      "enum": [
        "high_school",
        "undergraduate",
        "graduate",
        "vocational"
      ],
      "default": "undergraduate",
      "description": "Education level of the students"
    },
    "safety_bounds": {
      "type": "string",
      "enum": [
        "strict",
        "moderate",
        "open"
      ],
      "default": "moderate",
      "description": "Maximum hazard level students are allowed to test: strict = household-safe only, moderate = lab-safe, open = all"
    },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "student_name": {
            "type": "string"
          },
          "student_email": {
            "type": "string"
          },
          "joined_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "List of enrolled students"
    },
    "research_focus": {
      "type": "string",
      "description": "Teacher-defined research scope or learning objectives for the class"
    },
    "max_students": {
      "type": "number",
      "default": 50,
      "description": "Maximum number of students allowed to enroll"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the classroom is currently active for student submissions"
    },
    "settings": {
      "type": "object",
      "properties": {
        "allow_student_experiments": {
          "type": "boolean",
          "default": true
        },
        "require_teacher_approval": {
          "type": "boolean",
          "default": true
        },
        "show_citations": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": [
    "name",
    "class_code",
    "subject"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.roster.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}