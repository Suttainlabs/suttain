{
  "name": "ResearchApiJob",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "SimulationDraft",
        "SimulationJob",
        "DrugDiscoveryJob"
      ]
    },
    "record_id": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "record_type",
    "record_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}