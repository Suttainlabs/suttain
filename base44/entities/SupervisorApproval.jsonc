{
  "name": "SupervisorApproval",
  "properties": {
    "chemicals_summary": {
      "description": "Denormalized chemical names for quick display on the dashboard",
      "type": "string"
    },
    "decided_date": {
      "description": "When the supervisor approved or rejected the request",
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "description": "Optional short description for search visibility and previews",
      "maxLength": 1000,
      "type": "string"
    },
    "persona": {
      "description": "Simulator persona the request originated from (e.g. researcher, teacher)",
      "type": "string"
    },
    "requested_date": {
      "description": "When the request was created",
      "format": "date-time",
      "type": "string"
    },
    "requester_email": {
      "description": "Requester email \u2014 receives the approval/rejection notification",
      "format": "email",
      "type": "string"
    },
    "requester_name": {
      "description": "Requester display name",
      "type": "string"
    },
    "requester_user_id": {
      "description": "User id of the requester (denormalized from created_by_id)",
      "type": "string"
    },
    "simulation_id": {
      "description": "Optional reference to the originating Simulation entity",
      "type": "string"
    },
    "simulation_snapshot": {
      "additionalProperties": true,
      "description": "Full simulation data, chemicals, persona and experimental conditions captured at request time",
      "type": "object"
    },
    "status": {
      "default": "pending",
      "description": "Current approval status",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "supervisor_decision_reason": {
      "description": "Optional reason supplied by the supervisor when approving or rejecting",
      "type": "string"
    },
    "supervisor_email": {
      "description": "Supervisor email \u2014 receives the preview/approve link",
      "format": "email",
      "type": "string"
    },
    "supervisor_name": {
      "description": "Supervisor name as entered by the requester",
      "type": "string"
    },
    "token": {
      "description": "Unique unguessable signed token used in the public approval link",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    }
  },
  "required": [
    "token",
    "supervisor_name",
    "supervisor_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}