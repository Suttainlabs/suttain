{
  "name": "SupplierVerification",
  "properties": {
    "admin_notes": {
      "description": "Internal notes from the user reviewing the submission",
      "type": "string"
    },
    "description": {
      "description": "Optional short description for search visibility and previews",
      "maxLength": 1000,
      "type": "string"
    },
    "document_urls": {
      "description": "URLs of documents uploaded by the supplier",
      "items": {
        "type": "string"
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "array"
    },
    "expires_at": {
      "description": "When the verification link expires",
      "format": "date-time",
      "type": "string"
    },
    "formula_id": {
      "description": "ID of the formula being verified",
      "type": "string"
    },
    "formula_name": {
      "description": "Name of the formula for display",
      "type": "string"
    },
    "ingredients_to_verify": {
      "description": "List of ingredient names the supplier needs to verify",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "invited_by": {
      "description": "Email of the user who sent the invite",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "Current status of the verification request",
      "enum": [
        "pending",
        "submitted",
        "validated",
        "rejected"
      ],
      "type": "string"
    },
    "submitted_data": {
      "additionalProperties": true,
      "description": "Data submitted by the supplier (ingredient certs, COAs, safety sheets)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "object"
    },
    "supplier_email": {
      "description": "Email of the supplier contact",
      "type": "string"
    },
    "supplier_name": {
      "description": "Name of the supplier company",
      "type": "string"
    },
    "supplier_notes": {
      "description": "Notes or comments submitted by the supplier",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "token": {
      "description": "Unique secure token for the supplier's verification link",
      "type": "string"
    }
  },
  "required": [
    "formula_id",
    "formula_name",
    "supplier_email",
    "ingredients_to_verify",
    "token"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.supplier_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}