{
  "name": "SimulationDraft",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "A user-defined name for the simulation session."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "chemicals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of chemical names in the simulation."
    },
    "simulationParams": {
      "type": "object",
      "additionalProperties": true,
      "description": "The parameters set for the simulation (temperature, pressure, etc.)"
    }
  },
  "required": [
    "name",
    "chemicals"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}