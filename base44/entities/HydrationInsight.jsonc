{
  "name": "HydrationInsight",
  "type": "object",
  "properties": {
    "insight_type": {
      "type": "string",
      "enum": [
        "daily_biological_report",
        "sodium_alert",
        "inflammation_alert",
        "chemical_alert",
        "streak_milestone",
        "weekly_summary"
      ],
      "description": "Type of insight"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical",
        "positive"
      ],
      "default": "info"
    },
    "insight_date": {
      "type": "string",
      "format": "date"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Supporting data for this insight"
    },
    "recommendation": {
      "type": "string"
    }
  },
  "required": [
    "insight_type",
    "title",
    "message",
    "insight_date"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}