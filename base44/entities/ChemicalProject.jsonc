{
  "name": "ChemicalProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project or research phase name"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the project"
    },
    "color": {
      "type": "string",
      "description": "Hex color for the project folder",
      "default": "#6B3FA0"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "formulation",
        "toxicology",
        "computational",
        "regulatory",
        "materials",
        "environmental",
        "analytical",
        "custom"
      ],
      "description": "Category of research this project represents"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "in_progress",
        "completed",
        "archived"
      ],
      "default": "planning",
      "description": "Workflow status for the kanban board"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Standard tags applied from the selected template"
    },
    "notes": {
      "type": "string",
      "description": "Initial research notes or objectives from the template"
    },
    "template_id": {
      "type": "string",
      "description": "Identifier of the template used to create this project, if any"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}