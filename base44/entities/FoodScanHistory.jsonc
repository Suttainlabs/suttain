{
  "name": "FoodScanHistory",
  "type": "object",
  "properties": {
    "food_name": {
      "type": "string"
    },
    "food_input": {
      "type": "string"
    },
    "calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "fiber_g": {
      "type": "number"
    },
    "nova_score": {
      "type": "number"
    },
    "nova_label": {
      "type": "string"
    },
    "chemical_threat_level": {
      "type": "string"
    },
    "chemical_threat_score": {
      "type": "number"
    },
    "overall_summary": {
      "type": "string"
    },
    "portion_estimate": {
      "type": "string"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "food_name",
    "calories"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}