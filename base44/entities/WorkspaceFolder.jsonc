{
  "name": "WorkspaceFolder",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Folder name"
    },
    "color": {
      "type": "string",
      "description": "Hex color for the folder"
    },
    "icon": {
      "type": "string",
      "description": "Icon name for the folder"
    },
    "description": {
      "type": "string",
      "description": "Optional folder description"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}