{
  "name": "CustomLibrary",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Library name"
    },
    "description": {
      "type": "string",
      "description": "Library description"
    },
    "chemicals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "scientific_name": {
            "type": "string"
          },
          "cas_number": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      },
      "description": "List of chemicals in the library"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "team_id": {
      "type": "string",
      "description": "Team ID if shared with a team"
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user emails with access"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "use_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_public": true
        },
        {
          "data.shared_with": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}