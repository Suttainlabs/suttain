{
  "name": "ChemicalTag",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "chemical_id": {
      "type": "string",
      "description": "ID or PubChem CID of the tagged chemical"
    },
    "chemical_name": {
      "type": "string",
      "description": "Display name of the chemical (denormalized for quick display)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user-defined tags (project names, research phases, etc.)"
    }
  },
  "required": [
    "chemical_id",
    "chemical_name",
    "tags"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}