{
  "name": "UserHealthProfile",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "life_stage": {
      "type": "string",
      "enum": [
        "adult",
        "pregnant",
        "nursing",
        "child",
        "adolescent",
        "elderly"
      ],
      "default": "adult",
      "description": "User's current life stage for population-level risk assessment"
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known allergies (ingredient names or chemical classes)"
    },
    "health_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Diagnosed health conditions (e.g. endocrine disorder, asthma, sensitive skin)"
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Current medications for drug-interaction screening"
    },
    "sensitivity_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User-flagged sensitivities (e.g. fragrance-sensitive, hormone-sensitive)"
    },
    "asthma_sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has asthma trigger sensitivity"
    },
    "skin_condition": {
      "type": "string",
      "enum": [
        "normal",
        "sensitive",
        "eczema",
        "acne_prone"
      ],
      "default": "normal",
      "description": "User's skin condition for personalized ingredient warnings"
    },
    "avoid_ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-text list of ingredients the user avoids (entered one per line)"
    }
  },
  "required": [],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}