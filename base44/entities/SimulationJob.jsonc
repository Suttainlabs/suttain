{
  "name": "SimulationJob",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string",
      "description": "Parent SimulationDraft workspace"
    },
    "job_hash": {
      "type": "string",
      "description": "Audit identifier for this job"
    },
    "job_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "sim_type": {
      "type": "string"
    },
    "sim_type_label": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "environmental_params": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Completed means workflow operation finished; local_pending execution mode means preparation only, not completed compute."
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "description": "Provider output or prepared local input package, identified by execution_mode"
    },
    "error": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "provider_job_id": {
      "type": "string",
      "description": "Real compute receipt, or PubChem source CID for lookup; empty for prepared local jobs"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "real",
        "demonstration",
        "local_pending"
      ],
      "default": "demonstration",
      "description": "local_pending means generated files awaiting execution outside Suttain"
    }
  },
  "required": [
    "draft_id",
    "job_hash",
    "job_name",
    "sim_type",
    "engine"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}