{
  "name": "SimulationJob",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string",
      "description": "Reference to the parent SimulationDraft workspace this job belongs to"
    },
    "job_hash": {
      "type": "string",
      "description": "Unique hash identifier for this job \u2014 generated from configuration + environmental params + timestamp for auditability"
    },
    "job_name": {
      "type": "string",
      "description": "User-defined name for this job"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description for search visibility and previews"
    },
    "sim_type": {
      "type": "string",
      "description": "Simulation type ID (e.g. dft, molecular_dynamics)"
    },
    "sim_type_label": {
      "type": "string",
      "description": "Human-readable simulation type label"
    },
    "engine": {
      "type": "string",
      "description": "Software engine (e.g. GROMACS, ORCA)"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Key-value input parameters for this job"
    },
    "environmental_params": {
      "type": "object",
      "additionalProperties": true,
      "description": "Environmental parameters snapshot at time of job creation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Current execution status"
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "description": "AI-generated result data after execution"
    },
    "error": {
      "type": "string",
      "description": "Error message if job failed"
    },
    "order": {
      "type": "number",
      "description": "Position in the queue"
    }
  },
  "required": [
    "draft_id",
    "job_hash",
    "job_name",
    "sim_type",
    "engine"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}