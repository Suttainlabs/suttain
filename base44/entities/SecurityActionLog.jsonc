{
  "name": "SecurityActionLog",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "bucket": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    }
  },
  "required": [
    "actor_id",
    "channel",
    "bucket"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}