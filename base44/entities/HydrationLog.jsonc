{
  "name": "HydrationLog",
  "type": "object",
  "properties": {
    "amount_ml": {
      "type": "number",
      "description": "Amount consumed in millilitres"
    },
    "drink_type": {
      "type": "string",
      "enum": [
        "water",
        "sparkling_water",
        "herbal_tea",
        "green_tea",
        "coconut_water",
        "electrolyte_drink",
        "other"
      ],
      "default": "water"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "manual",
        "reminder",
        "auto"
      ],
      "default": "manual"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "log_date": {
      "type": "string",
      "format": "date",
      "description": "Date only for easy daily queries"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "amount_ml",
    "logged_at",
    "log_date"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}